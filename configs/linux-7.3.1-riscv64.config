# WASMNux Reproducible Linux 7.3.1 RISC-V 64-bit Guest Kernel Configuration
# Target ISA: RV64IMAFDC + Zicsr + Zifencei + Zba + Zbb, Sv39 MMU, Uniprocessor

CONFIG_NONPORTABLE=y
# CONFIG_SMP is not set
CONFIG_ARCH_RV64I=y
CONFIG_CMODEL_MEDANY=y
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_ZBA=y
CONFIG_RISCV_ISA_ZBB=y

# Explicitly disable optional RISC-V extensions outside the WASMNux RV64GC+Zba+Zbb baseline
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_SUPM is not set
# CONFIG_RISCV_ISA_SSQOSID is not set
# CONFIG_RISCV_ISA_SVRSW60T59B is not set
# CONFIG_RISCV_ALTERNATIVE is not set

# STRICT_KERNEL_RWX forces 2 MiB SECTION_ALIGN in
# arch/riscv/include/asm/set_memory.h, which injects two multi-megabyte
# alignment gaps into the Image. The guest never remaps kernel text, so the
# protection is not used; leaving it off keeps the payload small, and payload
# size is what bounds cold-boot time because the guest decompresses it.
# CONFIG_STRICT_KERNEL_RWX is not set

# Pure RISC-V Linux Image without UEFI stub or loadable module overhead
# CONFIG_EFI is not set
# CONFIG_RELOCATABLE is not set
# CONFIG_MODULES is not set
# -O2, not -Os. The guest executes on an interpreter, so instruction count
# dominates wall-clock time; -Os saves image bytes but retires measurably more
# instructions during boot. Size is instead controlled by not padding the image
# (see the STRICT_KERNEL_RWX note above).
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# Core kernel, scheduler, timers, and diagnostics
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_POSIX_TIMERS=y
CONFIG_TICK_CPU_ACCOUNTING=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_KALLSYMS=y
CONFIG_SYSCTL=y
CONFIG_EMBEDDED=n
CONFIG_EXPERT=y
# EXPERT selects DEBUG_KERNEL, and ARCH_WANT_FRAME_POINTERS (selected
# unconditionally by arch/riscv) turns FRAME_POINTER on as a result. Frame
# pointers cost a measurable amount of interpreter throughput and nothing in
# WASMNux unwinds kernel stacks, so keep them off explicitly.
# CONFIG_FRAME_POINTER is not set

# Hardening that costs instructions on every call. The guest is a WASM sandbox
# executing on an RV64 interpreter, so per-call overhead is paid in full and
# multiplies across boot:
#   INIT_STACK_ALL_ZERO      zero-fills every stack frame
#   RANDOMIZE_KSTACK_OFFSET  randomizes the stack pointer on entry
#   STACKPROTECTOR_STRONG    canary check on every function with an array
# Together these accounted for roughly 45M of the ~67M instructions the guest
# retired before printing its first kernel message, versus ~21M for the
# previously shipped (unhardened) kernel. They protect against memory-safety
# bugs in the guest kernel, which cannot escape the WASM sandbox anyway.
# This is a *choice*: `# ... is not set` cannot clear it, because the choice
# defaults to INIT_STACK_ALL_ZERO whenever the compiler supports the flag.
# Select the "none" member explicitly.
# SLUB_DEBUG adds red-zoning and sanity checks to the slab allocator. Every
# kmalloc during boot pays for it, and boot-time allocation count is what an
# interpreter-bound guest is most sensitive to.
# CONFIG_SLUB_DEBUG is not set
CONFIG_INIT_STACK_NONE=y
# CONFIG_RANDOMIZE_KSTACK_OFFSET is not set
# CONFIG_STACKPROTECTOR is not set

# Process execution, IPC, & Debian 13 (glibc 2.41 + apt 3.0 + dpkg) syscall surface
CONFIG_MMU=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_KCMP=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

# Namespaces, cgroups, and seccomp (used by apt _apt sandbox & container tools)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Initramfs & compression.
#
# The kernel Image is NOT self-decompressing. The guest runtime loads the raw
# `Image` straight into guest RAM, so an in-guest decompressor would only add
# work: choosing KERNEL_GZIP pulls in all six decoders (gzip, bzip2, lzma, xz,
# lzo, lz4, zstd) because the decompress helpers are linked unconditionally,
# and the guest then executes that decompressor on an interpreter. Measured in
# this VM, a self-decompressing gzip Image retired ~67M instructions before the
# first kernel message versus ~21M for an uncompressed Image.
#
# The previously shipped kernel was uncompressed too: its first bytes are a
# direct `j` instruction, not a decompressor entry point.
CONFIG_KERNEL_UNCOMPRESSED=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Block layer & filesystems
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y

# Networking (IPv4 TCP/UDP/ICMP/ARP over VirtIO-Net eth0 + loopback + Unix sockets)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

# Device Tree, Interrupts, Timers, Syscon Reset/Poweroff, and Goldfish RTC
CONFIG_OF=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_RISCV_INTC=y
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_GOLDFISH=y

# TTY, PTY, NS16550A Serial Console, and SBI HVC fallback
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HVC_DRIVER=y
CONFIG_HVC_RISCV_SBI=y

# VirtIO MMIO v2 transports & devices (Block, Network, Hardware RNG)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# SimpleFB Graphics Framebuffer (/dev/fb0 @ 0x50000000 640x400 XRGB8888 + fbcon)
# CONFIG_DRM is not set
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
