{
  "name": "wasmnux-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser runtime for WASMNux: VM lifecycle, WASM bindings, OPFS storage, WebGPU/Canvas rendering, terminal.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src index.html",
    "format:check": "prettier --check src index.html"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
